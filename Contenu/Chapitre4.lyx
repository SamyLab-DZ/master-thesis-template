\begin_layout Standard
Soient 
\begin_inset Formula $\mathbf{A}=[a_{ij}]$
\end_inset

 une matrice 
\begin_inset Formula $n\times p$
\end_inset

 et 
\begin_inset Formula $\mathbf{B}=[b_{ij}]$
\end_inset

 une matrice 
\begin_inset Formula $p\times q$
\end_inset

. Le produit de ces deux matrices est la matrice 
\begin_inset Formula $\mathbf{C}=\mathbf{A}\mathbf{B}$
\end_inset

, qui a pour dimension 
\begin_inset Formula $n\times q$
\end_inset

 et s'Ã©crit:
\end_layout

\begin_layout Standard

\begin_inset Formula \begin{displaymath}
\mathbf{C}=[c_{ij}] \ \text{avec} \ c_{ij}=\sum_{k=1}^{p}a_{ik}b_{kj}, \ \text{pour}\ 1\leq i\leq n \ \text{et} \ 1\leq j\leq q
\end{displaymath}
\end_inset


\end_layout

\begin_layout Standard

\begin_inset VSpace bigskip
\end_inset

Soient 
\begin_inset Newline newline
\end_inset

 
\begin_inset Formula \begin{displaymath}
\mathbf{A}=
\begin{pmatrix}
-2 & 1 \\
0 & 1 \\
-1 & 2
\end{pmatrix} \quad \text{et} \quad
\mathbf{B}=
\begin{pmatrix}
6 & 0 & 2\\
3 & -2 & 2
\end{pmatrix}
\end{displaymath}
\end_inset


\begin_inset Newline newline
\end_inset

 On a donc 
\begin_inset Formula \begin{displaymath}
\mathbf{C}=
\begin{pmatrix}
-2 & 1 \\
0 & 1 \\
-1 & 2
\end{pmatrix} \cdot
\begin{pmatrix}
6 & 0 & 2\\
3 & -2 & 2
\end{pmatrix}=
\begin{pmatrix}
-9 & -2 & -2 \\
3 & -2 & 2 \\
0 & -4 & 2
\end{pmatrix}
\end{displaymath}
\end_inset


